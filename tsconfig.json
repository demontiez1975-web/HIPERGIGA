{
  "compilerOptions":{
    "jsx":"react-jsx",
    "moduleResolution":"Bundler",
    "module":"ESNext",
    "target":"ES2022",
    "lib":["ES2022","DOM","DOM.Iterable"],
    "skipLibCheck":true,
    "strict":true,
    "esModuleInterop":true,
    "resolveJsonModule":true,
    "noEmit":true,
    "types":["vite/client"]
  },
  "include":["src/**/*.ts","src/**/*.tsx","vite.config.ts"]
}